#pragma code_page(65001)
#include <windows.h>

1 ICON "@ICON@"
1 RT_MANIFEST "@MANIFEST@"

1 VERSIONINFO
FILEVERSION @VERSION_NUMERIC@
PRODUCTVERSION @VERSION_NUMERIC@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Superfik\0"
            VALUE "FileDescription", "Superfik\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "InternalName", "superfik\0"
            VALUE "OriginalFilename", "superfik.exe\0"
            VALUE "ProductName", "Superfik\0"
            VALUE "ProductVersion", "@VERSION@\0"
            VALUE "LegalCopyright", "Superfik contributors.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
