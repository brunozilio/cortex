{
  "id": "playwright",
  "name": "Playwright",
  "version": "1.0.0",
  "description": "Let agents drive a real browser.",
  "icon": "playwright",
  "category": "web",
  "mcp": [
    {
      "transport": "stdio",
      "name": "playwright",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium"
      ]
    }
  ],
  "instructions": "browser tools mcp__{{server}}__*.",
  "setup": {
    "command": "npx",
    "args": [
      "-y",
      "@playwright/mcp@latest",
      "install-browser",
      "chromium"
    ]
  }
}
