<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Superfik launches developer tools (git, claude) as child processes. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><false/>
  <key>com.apple.security.cs.disable-library-validation</key><false/>
  <!-- The voice agent's microphone: the hardened runtime refuses it
       without this. -->
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- Chromium's passkey store (Touch ID), as the bundled framework is
       patched to ask for it (superfik_browser::bundle::passkeys).
       __TEAM_ID__ is filled in by scripts/bundle-macos.sh, which drops this
       entry when unsigned. The last group keeps the app's own credentials
       (superfik_keychain::ACCESS_GROUP), so no build of the team is asked
       to allow them. -->
  <key>keychain-access-groups</key>
  <array><string>__TEAM_ID__.superfik.webauthn.v1</string><string>__TEAM_ID__.superfik.webauthn.v1-uvk</string><string>__TEAM_ID__.superfik.credentials</string></array>
</dict>
</plist>
